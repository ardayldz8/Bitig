# ============================================================
# Bitig — ortam değişkenleri
# Eksik değişken uygulamayı ÇÖKERTMEZ; ilgili entegrasyon devre dışı kalır
# ve arayüzde kurulum uyarısı gösterilir.
# ============================================================

# --- Supabase (Projelerim sayfası: veri + auth + realtime) ---
# Tanımlı değilse Projelerim sayfası "yerel mod"da localStorage kullanır.
# Şema: supabase/migrations/0001_projects.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role YALNIZCA sunucuda kullanılır (webhook'un veritabanına yazması için).
# Tarayıcıya asla gönderilmez. Dashboard → Settings → API Keys'ten alınır.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub App (OAuth App değil) ---
# Client ID/secret istenmez: kimlik doğrulama App ID + private key ile üretilen
# JWT üzerinden yürür. Client secret yalnızca kullanıcı OAuth akışında gerekir,
# uygulama o akışı kullanmadığı için secret hiç saklanmaz.
GITHUB_APP_ID=
# PEM içeriği tek satırda "\n" kaçışlarıyla yazılabilir.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# github.com/apps/<slug> adresindeki slug
GITHUB_APP_SLUG=

# --- OpenRouter (yalnızca görsel tanıma ve proje analizi; kalori verisi üretmez) ---
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash
OPENROUTER_PROJECT_MODEL=google/gemini-3.5-flash

# --- Kalori sayfası besin kaynakları ---
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
USDA_API_KEY=
# Not: Open Food Facts anahtar gerektirmez.

# --- Uygulama ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
