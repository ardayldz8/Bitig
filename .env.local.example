# --- OpenRouter (yalnızca GÖRSEL TANIMA için; kalori verisi üretmez) ---
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash

# --- FatSecret (ana besin kaynağı: Türk yemekleri, restoran, genel gıda) ---
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# --- USDA FoodData Central (temel/markasız gıdalar için fallback) ---
USDA_API_KEY=

# Not: Open Food Facts anahtar gerektirmez, ayrı değişkeni yoktur.
# Eksik anahtar uygulamayı çökertmez; ilgili sağlayıcı atlanır.
